# Official HTTPS origin, no path. Leave unset for the local review version.
# SITE_URL=https://your-real-domain.tld
# Set only after content/site.json and approvedRoutes have been reviewed.
SITE_INDEXING=false

# Step 25: disabled by default. Values below are placeholders, not credentials.
# Supabase: published article preview/import, server/CLI only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=

# CRM workflow endpoint. Receives the documented v1 lead payload.
LEADS_ENABLED=false
# CRM_PROVIDER=hubspot
# CRM_WEBHOOK_URL=https://your-workflow.example/webhook/leads
# CRM_WEBHOOK_TOKEN=

# Choose direct OR gtm to avoid duplicate collection. Requires visitor consent.
TRACKING_ENABLED=false
TRACKING_MODE=direct
# GA4_ID=G-XXXXXXXXXX
# META_PIXEL_ID=
# LINKEDIN_PARTNER_ID=
# GTM_ID=GTM-XXXXXXX
# GOOGLE_SITE_VERIFICATION=
